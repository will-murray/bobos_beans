---
import { gql } from '@shopify/hydrogen';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCT_CARD_FRAGMENT } from '../../lib/fragments';
import { formatPrice } from '../../lib/money';

const COLLECTION_QUERY = gql(
  `
  query Collection($handle: String!) {
    collection(handle: $handle) {
      id
      title
      handle
      descriptionHtml
      seo { title description }
      image { url altText }
      products(first: 24) { nodes { ...ProductCard } }
    }
  }
`,
  [PRODUCT_CARD_FRAGMENT],
);

// Shopify themes serve /collections/all as a built-in listing of every product
// even when no collection with that handle exists. The live main menu links to it.
const ALL_PRODUCTS_QUERY = gql(
  `
  query AllProducts {
    products(first: 50, sortKey: BEST_SELLING) { nodes { ...ProductCard } }
  }
`,
  [PRODUCT_CARD_FRAGMENT],
);

const { handle } = Astro.params;
const { data } = await Astro.locals.storefront.graphql(COLLECTION_QUERY, {
  variables: { handle: handle! },
});

let title: string;
let seoTitle: string | null | undefined;
let seoDescription: string | null | undefined;
let descriptionHtml = '';
let products: NonNullable<typeof data>['collection'] extends infer C
  ? C extends { products: { nodes: infer N } } ? N : never
  : never;

if (data?.collection) {
  const c = data.collection;
  title = c.title;
  seoTitle = c.seo.title;
  seoDescription = c.seo.description;
  descriptionHtml = c.descriptionHtml;
  products = c.products.nodes;
} else if (handle === 'all') {
  const all = await Astro.locals.storefront.graphql(ALL_PRODUCTS_QUERY);
  title = 'Products';
  products = all.data?.products.nodes ?? [];
} else {
  return Astro.rewrite('/404');
}
---

<BaseLayout title={seoTitle ?? title} description={seoDescription}>
  <h1>{title}</h1>
  {descriptionHtml && <div set:html={descriptionHtml} />}
  {products.length === 0 ? (
    <p>No products in this collection yet.</p>
  ) : (
    <ul>
      {products.map((p) => (
        <li>
          <a href={`/products/${p.handle}`}>
            {p.featuredImage && (
              <img src={p.featuredImage.url} alt={p.featuredImage.altText ?? ''} width="200" loading="lazy" />
            )}
            {p.title}
          </a>
          <p>{formatPrice(p.priceRange.minVariantPrice)}</p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
