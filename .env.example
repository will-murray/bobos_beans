# Shopify store domain. The Storefront API is served from the store's primary
# domain as well as its *.myshopify.com domain; either works here.
PUBLIC_STORE_DOMAIN=bobosbeans.ca

# Public Storefront API access token. Create one in Shopify admin:
# Settings -> Apps and sales channels -> Develop apps -> Create app ->
# Configure Storefront API scopes -> Install -> copy the public access token.
# Leave commented out until you have one; the client then runs tokenless,
# which only works against mock.shop stores, not a real store.
# PUBLIC_STOREFRONT_API_TOKEN=

# Optional private token for server-side requests with buyer context.
# PRIVATE_STOREFRONT_API_TOKEN=

# Analytics storefront id; "0" when the app has no storefront id.
PUBLIC_STOREFRONT_ID=0
